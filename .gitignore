# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------
# BillAlert — credentials and local data. NOTHING below may be committed.
# The Supabase URL and anon key are passed with --dart-define at build
# time and read through AppConfig. They never live in a tracked file.
# ---------------------------------------------------------------------
.env
.env.*
dart_define.json
dart_define.*.json
run_local.ps1
run_local.sh

# The encrypted on-device cache, if a build ever writes one into the repo.
*.sqlite
*.sqlite3
*.db

# A launch config is where the anon key most easily gets committed by
# accident. Copy .vscode/launch.json.example and fill in your own.
.vscode/launch.json

# Throwaway probe scripts. scratch/test_supabase.dart holds a real staff
# password in plain text, and this directory is where that kind of thing
# lands. Ignored so `git add .` cannot commit a credential.
scratch/

# Built from .vscode/launch.json for --dart-define-from-file. Same values,
# not a second secret, but keep it out of the repo all the same.
env.json
